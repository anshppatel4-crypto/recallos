<Window x:Class="RecallOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:RecallOS.App.ViewModels"
        xmlns:conv="clr-namespace:RecallOS.App.Converters"
        xmlns:ctl="clr-namespace:RecallOS.App.Controls"
        xmlns:views="clr-namespace:RecallOS.App.Views"
        xmlns:models="clr-namespace:RecallOS.Core.Models;assembly=RecallOS.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="RecallOS"
        Height="820" Width="1280"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgBase}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- Custom chrome: the standard title bar would sit outside the design system. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePath" />
        <conv:RelativeTimeConverter x:Key="RelativeTime" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:CountToVisibilityConverter x:Key="ZeroToVisibility" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <conv:EnumEqualityConverter x:Key="EnumEquality" />
        <conv:ActivityHeightConverter x:Key="ActivityHeight" />
        <conv:IntentColorConverter x:Key="IntentColor" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding StepCommand}" CommandParameter="back" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding StepCommand}" CommandParameter="forward" />
        <KeyBinding Key="Delete" Modifiers="Control" Command="{Binding DeleteSelectedCommand}" />
    </Window.InputBindings>

    <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ Title bar ============================ -->
            <Grid Grid.Row="0" Background="{StaticResource BgSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE81C;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="11"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RecallOS"
                               Style="{StaticResource H2}"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0" />
                    <Border Style="{StaticResource Pill}" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL" Style="{StaticResource Micro}" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Recording status, centred in the caption -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        <!-- A slow pulse: unmistakable that recording is live, without nagging. -->
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Pulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.25" Duration="0:0:1.1"
                                                                     AutoReverse="True"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Micro}">
                                <Setter Property="Text" Value="Paused" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Text" Value="Recording" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Proof of life between captures: without a countdown the window looks
                         identical whether the recorder is running or has died. -->
                    <TextBlock Style="{StaticResource Micro}"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0"
                               Foreground="{StaticResource Accent}"
                               Text="{Binding RecordingStatus}"
                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" ToolTip="Minimise" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" ToolTip="Maximise" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseButton}" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ============================ Command bar ============================ -->
            <Grid Grid.Row="1" Background="{StaticResource BgSurface}" Margin="0,0,0,1">
                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="14,10,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource CommandBar}"
                                     Padding="40,10,86,10"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="&#xE721;"
                                       Style="{StaticResource Icon}"
                                       FontSize="14"
                                       HorizontalAlignment="Left"
                                       Margin="14,0,0,0"
                                       IsHitTestVisible="False" />

                            <TextBlock IsHitTestVisible="False"
                                       Margin="40,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="14"
                                       Text="Search everything you have seen">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Keyboard affordance, hidden once there is a query to clear -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Background="{StaticResource BgActive}"
                                    CornerRadius="5"
                                    Padding="7,3"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Ctrl F" Style="{StaticResource Micro}" FontFamily="{StaticResource MonoFont}" />
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Button Content="&#xE894;"
                                    Width="28" Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,7,0"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="Clear">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <ProgressBar Height="2"
                                         VerticalAlignment="Bottom"
                                         Margin="1,0,1,1"
                                         IsIndeterminate="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource Accent}"
                                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <!-- Ranking mode -->
                        <Border Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Background="{StaticResource BgBase}"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Hybrid" GroupName="Mode" Style="{StaticResource ModeToggle}"
                                             IsChecked="{Binding SearchMode, Converter={StaticResource EnumEquality}, ConverterParameter=Hybrid}"
                                             ToolTip="Words and meaning combined" />
                                <RadioButton Content="Words" GroupName="Mode" Style="{StaticResource ModeToggle}"
                                             IsChecked="{Binding SearchMode, Converter={StaticResource EnumEquality}, ConverterParameter=Keyword}"
                                             ToolTip="Exact full-text matching" />
                                <RadioButton Content="Meaning" GroupName="Mode" Style="{StaticResource ModeToggle}"
                                             IsChecked="{Binding SearchMode, Converter={StaticResource EnumEquality}, ConverterParameter=Semantic}"
                                             ToolTip="Similarity over the semantic index" />
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CaptureNowCommand}"
                                    IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolean}}"
                                    ToolTip="Capture the screen now  (Ctrl+Shift+R from anywhere)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Capture" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleRecordingCommand}"
                                    ToolTip="Start or pause continuous recording">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,7,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;" />
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Text" Value="&#xE769;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Record" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Text" Value="Pause" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Button Content="&#xE713;"
                                    Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleSettingsCommand}"
                                    ToolTip="Settings" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================ Results + replay ============================ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="330" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!-- Results -->
                <Grid Grid.Column="0" Margin="12,12,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,10,9">
                        <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Warning}"
                                   Style="{StaticResource Micro}"
                                   Foreground="{StaticResource Warning}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="250"
                                   ToolTip="{Binding Warning}"
                                   Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             x:Name="ResultsList"
                             Style="{StaticResource ResultListBox}"
                             ItemContainerStyle="{StaticResource ResultListItem}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedFrame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FrameItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- DecodePixelWidth keeps a list of 4K frames cheap to scroll. -->
                                    <Border Grid.Column="0"
                                            Width="124" Height="70"
                                            CornerRadius="7"
                                            Background="{StaticResource BgBase}"
                                            BorderBrush="{StaticResource Stroke}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            Margin="0,0,12,0">
                                        <Image Source="{Binding PreviewPath, Converter={StaticResource ImagePath}, ConverterParameter=248}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Body}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,5">
                                            <TextBlock Text="{Binding CapturedAt, Converter={StaticResource RelativeTime}}"
                                                       Style="{StaticResource Micro}"
                                                       VerticalAlignment="Center" />

                                            <Border Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding IntentLabel, Converter={StaticResource IntentColor}}"
                                                    Visibility="{Binding HasIntent, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding IntentLabel}"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FF0A0B0F" />
                                            </Border>

                                            <TextBlock Text="{Binding ProcessName}"
                                                       Style="{StaticResource Micro}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Matches highlighted from structured spans, not embedded markup. -->
                                        <TextBlock Style="{StaticResource Micro}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="48"
                                                   LineHeight="15"
                                                   TextTrimming="CharacterEllipsis"
                                                   ctl:HighlightedTextBlock.SourceText="{Binding Snippet}"
                                                   ctl:HighlightedTextBlock.Highlights="{Binding Highlights}"
                                                   ctl:HighlightedTextBlock.HighlightBrush="{StaticResource Highlight}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="34"
                                Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="16"
                                Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE81C;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="22"
                                       Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing here yet"
                                   Style="{StaticResource H1}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextTertiary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="290"
                                   Margin="0,7,0,0"
                                   Text="Capture the screen, or switch on continuous recording. Everything is stored on this machine and nothing is ever uploaded." />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="False" />

                <!-- Replay -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,12,12,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="0,0,0,1"
                                Padding="16,13"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SelectedFrame.Title}"
                                               Style="{StaticResource H2}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Micro}"
                                                   Text="{Binding SelectedFrame.CapturedAt, StringFormat='{}{0:ddd d MMM yyyy, HH:mm:ss}'}" />
                                        <TextBlock Style="{StaticResource Micro}" Text="  &#183;  " />
                                        <TextBlock Style="{StaticResource Micro}" Text="{Binding SelectedFrame.SizeText}" />
                                        <TextBlock Style="{StaticResource Micro}" Text="  &#183;  " />
                                        <TextBlock Style="{StaticResource Micro}"
                                                   Foreground="{StaticResource Accent}"
                                                   Text="{Binding SelectedFrame.MatchExplanation}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}"
                                            Command="{Binding StepCommand}" CommandParameter="back"
                                            ToolTip="Previous frame in time  (Alt+Left)" />
                                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}"
                                            Command="{Binding StepCommand}" CommandParameter="forward"
                                            ToolTip="Next frame in time  (Alt+Right)" />
                                    <Rectangle Width="1" Margin="7,7" Fill="{StaticResource Stroke}" />
                                    <Button Content="&#xE8A7;" Style="{StaticResource IconButton}"
                                            Command="{Binding OpenImageCommand}"
                                            ToolTip="Open the full image" />
                                    <Button Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                            Command="{Binding CopyTextCommand}"
                                            ToolTip="Copy the extracted text" />
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}"
                                            Foreground="{StaticResource Danger}"
                                            Command="{Binding DeleteSelectedCommand}"
                                            ToolTip="Delete this frame and its image  (Ctrl+Delete)" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1"
                                    Style="{StaticResource FlatTabControl}"
                                    ItemContainerStyle="{StaticResource FlatTabItem}"
                                    Margin="12,9,12,12"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TabItem Header="Screen">
                                <Border Background="{StaticResource BgBase}"
                                        BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,9,0,0"
                                        ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image Source="{Binding SelectedImagePath, Converter={StaticResource ImagePath}, ConverterParameter=1900}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                </Border>
                            </TabItem>

                            <TabItem Header="Extracted text">
                                <Border Background="{StaticResource BgBase}"
                                        BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,9,0,0">
                                    <TextBox Text="{Binding SelectedFrameText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextSecondary}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"
                                             Padding="16"
                                             VerticalScrollBarVisibility="Auto"
                                             SelectionBrush="{StaticResource Accent}" />
                                </Border>
                            </TabItem>
                        </TabControl>

                        <!-- Nothing selected -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE7C5;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="26"
                                       Foreground="{StaticResource StrokeStrong}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Select a moment to replay it"
                                       Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextTertiary}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================ Timeline ============================ -->
            <Border Grid.Row="3" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,1" Padding="18,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding Timeline.RangeLabel}" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Micro}"
                                   Text="{Binding Timeline.TotalFrames, StringFormat='{}{0:N0} frames'}" />
                    </StackPanel>

                    <!-- Each bar is a clickable slice of time; height is log-scaled so quiet periods stay visible. -->
                    <ScrollViewer Grid.Column="1" Height="48" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Timeline.Buckets}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TimelineBucket}">
                                    <Button Width="9" Margin="1,0" VerticalAlignment="Bottom" Cursor="Hand"
                                            Height="{Binding FrameCount, Converter={StaticResource ActivityHeight}}"
                                            Command="{Binding DataContext.Timeline.SelectBucketCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Start, StringFormat='{}{0:ddd d MMM  HH:mm}'}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FrameCount, StringFormat='{}{0:N0} frames'}" Opacity="0.75" />
                                                <TextBlock Text="{Binding DominantApp}" Opacity="0.75" />
                                                <TextBlock Text="{Binding DominantIntent}" Opacity="0.75" />
                                            </StackPanel>
                                        </Button.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bar"
                                                        Background="{Binding DominantIntent, Converter={StaticResource IntentColor}}"
                                                        CornerRadius="3"
                                                        Opacity="0.7" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="30" Height="30"
                                Command="{Binding Timeline.ShiftCommand}" CommandParameter="back" ToolTip="Earlier" />
                        <Button Content="Today" Style="{StaticResource SubtleButton}"
                                Command="{Binding Timeline.ShowTodayCommand}" />
                        <Button Content="Week" Style="{StaticResource SubtleButton}"
                                Command="{Binding Timeline.ShowWeekCommand}" />
                        <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="30" Height="30"
                                Command="{Binding Timeline.ShiftCommand}" CommandParameter="forward" ToolTip="Later" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Status bar ============================ -->
            <Border Grid.Row="4" Background="{StaticResource BgBase}" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Style="{StaticResource Micro}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- A skip is a decision, not a fault; saying so keeps a static
                             frame count from looking like a broken recorder. -->
                        <TextBlock Style="{StaticResource Micro}"
                                   Margin="0,0,16,0"
                                   Foreground="{StaticResource TextTertiary}"
                                   Text="{Binding SkipSummary}"
                                   Visibility="{Binding SkippedCount, Converter={StaticResource CountToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                    Visibility="{Binding QueueDepth, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Micro}"
                                       Foreground="{StaticResource Accent}"
                                       Text="{Binding QueueDepth, StringFormat='{}{0:N0} reading'}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Micro}" Text="{Binding StorageSummary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Settings overlay ============================ -->
            <Grid Grid.Row="0" Grid.RowSpan="5"
                  Background="#E605060A"
                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Width="700" MaxHeight="760" Margin="28"
                        Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource StrokeStrong}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.65" Color="Black" />
                    </Border.Effect>
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>

            <!-- ============================ First-run welcome ============================ -->
            <Grid Grid.Row="0" Grid.RowSpan="5"
                  Background="#F205060A"
                  Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                <Border Width="560" Style="{StaticResource Card}" CornerRadius="16" Padding="38,34" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="12" Opacity="0.7" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="15"
                                Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="A memory layer for your screen"
                                   Style="{StaticResource Display}"
                                   TextWrapping="Wrap"
                                   Margin="0,22,0,0" />

                        <TextBlock Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,10,0,0"
                                   Text="RecallOS records what you see, reads the text on it, and makes all of it searchable. Everything is stored on this machine — there is no account, no sync and no telemetry." />

                        <Border Background="{StaticResource BgBase}" CornerRadius="10" Padding="16,14" Margin="0,22,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}"
                                               Text="Press Capture, or Ctrl+Shift+R from anywhere." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}"
                                               TextWrapping="Wrap" MaxWidth="420"
                                               Text="To search the text inside your captures, install a language pack once from Settings." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}"
                                               TextWrapping="Wrap" MaxWidth="420"
                                               Text="Add apps you never want recorded to the exclusion list in Settings." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Content="Open settings" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenSettingsFromWelcomeCommand}" />
                            <Button Content="Start using RecallOS" Style="{StaticResource PrimaryButton}"
                                    Margin="10,0,0,0"
                                    Command="{Binding DismissWelcomeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
