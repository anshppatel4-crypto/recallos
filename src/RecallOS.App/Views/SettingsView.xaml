<UserControl x:Class="RecallOS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RecallOS.App.ViewModels"
             xmlns:conv="clr-namespace:RecallOS.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <conv:EnumDisplayConverter x:Key="EnumDisplay" />

        <!-- Shared by both enum dropdowns so the closed and open states always agree. -->
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Display}" FontSize="21" />
                    <TextBlock Style="{StaticResource Caption}"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="0,4,0,0"
                               Text="Everything RecallOS records stays on this machine." />
                </StackPanel>

                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip="Close  (Esc)"
                        Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel Margin="0,0,8,20">

                <!-- ============ Recording ============ -->
                <TextBlock Text="RECORDING" Style="{StaticResource SectionLabel}" Margin="0,18,0,10" />

                <CheckBox Content="Record continuously in the background"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding AutoCaptureEnabled}" />

                <Grid Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Body}" Text="Capture every" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Body}"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBright}"
                               Text="{Binding CaptureIntervalSeconds, StringFormat='{}{0}s'}" />
                </Grid>
                <Slider Style="{StaticResource StandardSlider}" Minimum="2" Maximum="300" TickFrequency="1"
                        Value="{Binding CaptureIntervalSeconds}" />

                <TextBlock Style="{StaticResource Body}" Text="What to capture" Margin="0,14,0,5" />
                <ComboBox Style="{StaticResource StandardComboBox}"
                          ItemsSource="{Binding CaptureTargets}"
                          ItemTemplate="{StaticResource EnumItemTemplate}"
                          SelectedItem="{Binding AutoCaptureTarget}" />

                <Grid Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Body}" Text="Pause after this long with no input" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Body}"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBright}"
                               Text="{Binding IdleThresholdSeconds, StringFormat='{}{0}s'}" />
                </Grid>
                <Slider Style="{StaticResource StandardSlider}" Minimum="0" Maximum="900" TickFrequency="15"
                        Value="{Binding IdleThresholdSeconds}" />
                <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" LineHeight="16"
                           Text="Nothing changes on screen while you are away, so recording it only costs disk space. Set to 0 to record regardless." />

                <CheckBox Content="Save disk by skipping frames identical to the one before"
                          Style="{StaticResource ToggleSwitch}"
                          Margin="0,14,0,0"
                          IsChecked="{Binding SkipUnchangedFrames}" />
                <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" LineHeight="16"
                           Text="Off by default, so Record keeps recording. Turning it on saves space while you read or step away, but a screen that is not changing will stop producing frames until it does." />

                <CheckBox Content="Include the mouse pointer"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding IncludeCursor}" />

                <!-- ============ Privacy ============ -->
                <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}" />

                <Border Background="#14F87171" BorderBrush="#2EF87171" BorderThickness="1"
                        CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,1,11,0" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="530" LineHeight="17"
                                   Text="Anything on these lists is checked before the screen is read and again against the window that was actually in front. Excluded frames never reach the disk." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Body}" Text="Never capture these applications" />
                <TextBlock Style="{StaticResource Micro}" Margin="0,3,0,6" TextWrapping="Wrap"
                           Text="One process name per line, without .exe — for example: keepass, 1password, bitwarden" />
                <TextBox Style="{StaticResource StandardTextBox}" Height="74" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}"
                         Text="{Binding ExcludedProcesses, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Body}" Text="Never capture windows whose title contains" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Micro}" Margin="0,3,0,6" TextWrapping="Wrap"
                           Text="One phrase per line — for example: private browsing, incognito, password" />
                <TextBox Style="{StaticResource StandardTextBox}" Height="74" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}"
                         Text="{Binding ExcludedTitleKeywords, UpdateSourceTrigger=PropertyChanged}" />

                <!-- ============ Text extraction ============ -->
                <TextBlock Text="TEXT EXTRACTION" Style="{StaticResource SectionLabel}" />

                <CheckBox Content="Read the text in captures so they can be searched"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding OcrEnabled}" />

                <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOcrReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="500"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding OcrAvailability}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBox Style="{StaticResource StandardTextBox}" Width="120"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding OcrLanguages, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tesseract language codes joined with + — for example eng, or eng+deu" />
                            <Button Style="{StaticResource GhostButton}" Margin="9,0,0,0"
                                    Command="{Binding DownloadLanguageCommand}"
                                    CommandParameter="{Binding OcrLanguages}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Install language" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ProgressBar Height="3" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding DownloadProgress}"
                                     Background="{StaticResource BgActive}" BorderThickness="0"
                                     Foreground="{StaticResource Accent}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding InstalledLanguages}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                       Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Micro}"
                                                       Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Micro}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="16"
                                   Text="This is the only time RecallOS uses the network, and only when you press the button." />
                    </StackPanel>
                </Border>

                <!-- ============ Search ============ -->
                <TextBlock Text="SEARCH" Style="{StaticResource SectionLabel}" />

                <CheckBox Content="Build a semantic index for meaning-based search"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding SemanticIndexingEnabled}" />

                <TextBlock Style="{StaticResource Body}" Text="Default ranking mode" Margin="0,12,0,5" />
                <ComboBox Style="{StaticResource StandardComboBox}"
                          ItemsSource="{Binding SearchModes}"
                          ItemTemplate="{StaticResource EnumItemTemplate}"
                          SelectedItem="{Binding DefaultSearchMode}" />

                <!-- ============ Storage ============ -->
                <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}" />

                <Grid>
                    <TextBlock Style="{StaticResource Body}" Text="Keep frames for" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBright}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Text" Value="{Binding RetentionDays, StringFormat='{}{0} days'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RetentionDays}" Value="0">
                                        <Setter Property="Text" Value="forever" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Slider Style="{StaticResource StandardSlider}" Minimum="0" Maximum="365" TickFrequency="1"
                        Value="{Binding RetentionDays}" />

                <Grid Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Body}" Text="Use at most" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBright}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Text" Value="{Binding MaxStorageGigabytes, StringFormat='{}{0} GB'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MaxStorageGigabytes}" Value="0">
                                        <Setter Property="Text" Value="unlimited" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Slider Style="{StaticResource StandardSlider}" Minimum="0" Maximum="500" TickFrequency="1"
                        Value="{Binding MaxStorageGigabytes}" />
                <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" LineHeight="16"
                           Text="Set either limit to 0 to disable it. When a limit is passed, the oldest frames go first." />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Clean up now" Style="{StaticResource GhostButton}"
                            Command="{Binding RunRetentionCommand}" />
                    <Button Content="Open store folder" Style="{StaticResource GhostButton}" Margin="9,0,0,0"
                            Command="{Binding OpenStoreFolderCommand}" />
                    <Button Content="Erase everything" Style="{StaticResource DangerButton}" Margin="9,0,0,0"
                            Command="{Binding EraseEverythingCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Micro}" Margin="0,10,0,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFont}"
                           Text="{Binding StoreRoot}" />

                <!-- ============ Application ============ -->
                <TextBlock Text="APPLICATION" Style="{StaticResource SectionLabel}" />

                <TextBlock Style="{StaticResource Body}" Text="Capture shortcut" Margin="0,0,0,5" />
                <TextBox Style="{StaticResource StandardTextBox}" Width="200" HorizontalAlignment="Left"
                         FontFamily="{StaticResource MonoFont}"
                         Text="{Binding CaptureHotkey, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="For example Ctrl+Shift+R" />

                <CheckBox Content="Keep running in the notification area when the window is closed"
                          Style="{StaticResource ToggleSwitch}"
                          Margin="0,14,0,0"
                          IsChecked="{Binding MinimizeToTray}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                Background="{StaticResource BgBase}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,14,0"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Revert" Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" />
                    <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
