<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RecallOS</AssemblyName>
    <RootNamespace>RecallOS.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      WFAC010 tells Windows Forms apps to set DPI awareness through Application.SetHighDpiMode
      instead of the manifest. This is a WPF application that references Windows Forms only for
      NotifyIcon, and WPF reads DPI awareness from the manifest before any managed code runs.
      The manifest declaration is both the correct mechanism here and a hard requirement: without
      PerMonitorV2, BitBlt captures DPI-virtualised pixels and every screenshot on a scaled
      display is blurred and the wrong size.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- Program.Main is the entry point, so WPF must not generate its own. -->
    <StartupObject>RecallOS.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demoted from ApplicationDefinition so no second Main is generated. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(ExtensionsVersion)" />

    <!-- Produces the one-click installer and handles its install/update hooks. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecallOS.Core\RecallOS.Core.csproj" />
  </ItemGroup>

</Project>
